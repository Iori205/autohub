{
  "name": "autohub",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "web": "turbo run dev --filter=web",
    "dash": "turbo run dev --filter=dashboard",
    "service": "turbo run dev --filter=service",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:migrate": "npm run db:migrate -w @repo/db",
    "db:migrate:dev": "npm run db:migrate:dev -w @repo/db",
    "db:seed": "npm run db:seed -w @repo/db",
    "db:demo": "npm run db:demo -w @repo/db",
    "db:studio": "npm run db:studio -w @repo/db",
    "test:e2e": "npm run test -w e2e --"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

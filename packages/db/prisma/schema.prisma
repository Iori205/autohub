// AuToHub өгөгдлийн сан. Мөнгийг бүхэл төгрөгөөр (Int) хадгална.
// Холболтын мөрүүд язгуурын .env-д байна (.env.example-ийг үз).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- enum ----------

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum ProductType {
  ORIGINAL
  AFTERMARKET
}

enum Fuel {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum DeliveryMethod {
  /// Улаанбаатар доторх хүргэлт
  UB
  /// Хэрэглэгч салбараас өөрөө авна
  PICKUP
  /// Орон нутаг руу илгээнэ (автобус/карго)
  COUNTRY
}

enum PaymentStatus {
  PENDING
  PAID
  /// Төлбөрийн өмнө эсвэл дараа цуцалсан; paidAt != null бол мөнгө буцаагдсан
  CANCELLED
  /// QPay нэхэмжлэх төлөгдөлгүй хугацаа дууссан (15 мин)
  EXPIRED
}

enum DeliveryStatus {
  /// Эхлээгүй (төлөгдөөгүй, эсвэл төлөгдөөд хүлээж буй)
  NONE
  PREPARING
  /// Хүргэлтэнд гарсан / авахад бэлэн
  SHIPPING
  DELIVERED
}

enum InvoiceStatus {
  OPEN
  PAID
  /// хэрэглэгч эсвэл ажилтан цуцалсан
  CANCELLED
  EXPIRED
}

enum CampaignTarget {
  ALL
  CATEGORY
  BRAND
}

// ---------- хэрэглэгч ----------

model User {
  id           String    @id @default(cuid())
  role         Role      @default(CUSTOMER)
  /// Дэлгүүрийн үүсгэсэн нэргүй хөтчийн сесс (нэвтрэх мэдээлэлгүй)
  isGuest      Boolean   @default(false)
  name         String?
  phone        String?   @unique
  email        String?   @unique
  passwordHash String?
  address      String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cars           SavedCar[]
  wishlist       WishlistItem[]
  cart           Cart?
  orders         Order[]
  notes          OrderNote[]
  stockMovements StockMovement[]

  @@index([role])
}

/// Машин сонгогчоор сонгосон хэрэглэгчийн машин («Миний машин»)
model SavedCar {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String?
  make      String
  model     String
  year      Int
  engine    String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ---------- каталог ----------

/// make + model + хөдөлгүүрийн хувилбар бүрт нэг мөр
model Vehicle {
  id         String   @id @default(cuid())
  make       String
  model      String
  generation String   @default("")
  yearFrom   Int
  yearTo     Int
  engine     String
  fuel       Fuel
  createdAt  DateTime @default(now())

  fitments  ProductFitment[]
  savedCars SavedCar[]

  @@unique([make, model, engine])
  @@index([make, model])
}

model Category {
  id         String  @id @default(cuid())
  /// URL slug, жишээ нь /shop/brake
  slug       String  @unique
  name       String  @unique
  /// Web ба dashboard-ын нийтлэг дүрсний түлхүүр (cog, disc, filter …)
  icon       String
  sortOrder  Int     @default(0)
  /// Дэлгүүрийн нүүрний маркетингийн шошго («1,960 бараа»)
  countLabel String?

  products  Product[]
  campaigns Campaign[]
}

model Brand {
  id      String      @id @default(cuid())
  name    String      @unique
  country String      @default("")
  kind    ProductType @default(AFTERMARKET)

  products  Product[]
  campaigns Campaign[]
}

model Product {
  id                Int         @id @default(autoincrement())
  name              String
  description       String      @default("")
  brandId           String
  categoryId        String
  /// Эхнийх нь үндсэн OEM дугаар, бусад нь хөндлөн лавлагаа
  oemNumbers        String[]
  /// Хайлтад: oemNumbers-ийг зай, зураас, цэггүй том үсгээр
  oemSearch         String[]
  price             Int
  oldPrice          Int?
  stock             Int         @default(0)
  lowStockThreshold Int         @default(3)
  type              ProductType
  images            String[]
  /// [{ "k": "Байрлал", "v": "Урд тэнхлэг" }, …]
  specs             Json        @default("[]")
  /// «Санал болгох» дараалал дахь байрлал; бага нь эхэнд
  sortOrder         Int         @default(0)
  /// Тохирол баталгаажаагүй (дэлгүүр «тохирох эсэхийг шалгана уу» гэж харуулна)
  fitmentUnknown    Boolean     @default(false)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  brand          Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fitments       ProductFitment[]
  wishlistItems  WishlistItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sortOrder])
  @@index([oemSearch], type: Gin)
}

/// Бараа энэ машинд (хөдөлгүүрийн хувилбарт) тохирно. Оны баганууд машины өөрийн хүрээг нарийсгана;
/// null = бүх хүрээ.
model ProductFitment {
  id        String @id @default(cuid())
  productId Int
  vehicleId String
  yearFrom  Int?
  yearTo    Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleId])
  @@index([vehicleId])
}

// ---------- хүслийн жагсаалт ба сагс ----------

model WishlistItem {
  userId    String
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  cartId    String
  productId Int
  qty       Int
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([cartId, productId])
}

// ---------- захиалга ----------

model Order {
  id               String         @id @default(cuid())
  /// Хаа сайгүй харагдах дугаар: A1025, A1026 … (order_number_seq дараалал)
  number           String         @unique @default(dbgenerated("('A'::text || nextval('order_number_seq'::regclass))"))
  userId           String?
  customerName     String
  /// Зочин дараа нь утсаараа захиалгаа хайж болохоор захиалга бүрт хадгална
  customerPhone    String
  customerEmail    String?
  note             String?
  deliveryMethod   DeliveryMethod
  /// Хүргэлтийн бүтэн хаяг (эсвэл очиж авах салбарын хаяг)
  address          String
  district         String?
  khoroo           String?
  /// Захиалгын үеийн хэрэглэгчийн машин, жишээ нь «Toyota Land Cruiser 200 2015 · 1VD-FTV …»
  car              String?
  subtotal         Int
  shippingFee      Int
  total            Int
  paymentStatus    PaymentStatus  @default(PENDING)
  deliveryStatus   DeliveryStatus @default(NONE)
  qpayInvoiceId    String?        @unique
  qpayPaymentId    String?
  invoiceExpiresAt DateTime?
  paidAt           DateTime?
  preparingAt      DateTime?
  shippingAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  expiredAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  notes          OrderNote[]
  stockMovements StockMovement[]
  invoices       PaymentInvoice[]

  @@index([customerPhone])
  @@index([userId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId Int?
  /// Захиалгын үеийн хуулбар
  name      String
  oem       String?
  price     Int
  qty       Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

/// Захиалгад гаргасан QPay нэхэмжлэх (хугацаа дууссан/цуцалсныг шинэ нь орлоно).
/// Төлбөрийн дэлгэцийг дахин харуулахын тулд QR, банкны аппын холбоосыг хадгална.
model PaymentInvoice {
  /// QPay invoice_id (DEMO_MODE: «demo-…»)
  id        String        @id
  orderId   String
  amount    Int
  qrText    String
  /// data URL (QPay-ийн PNG, эсвэл DEMO_MODE-д локалд зурсан QR)
  qrImage   String
  shortUrl  String?
  /// [{ name, description, logo, link }] банк / хэтэвчний холбоос
  urls      Json          @default("[]")
  demo      Boolean       @default(false)
  status    InvoiceStatus @default(OPEN)
  paymentId String?
  expiresAt DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, expiresAt])
}

/// Захиалга дээрх ажилтны дотоод тэмдэглэл
model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  authorId   String?
  authorName String
  text       String
  createdAt  DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------- нөөц, маркетинг, тохиргоо ----------

model StockMovement {
  id         String   @id @default(cuid())
  productId  Int
  delta      Int
  reason     String
  orderId    String?
  actorId    String?
  /// Автомат хөдөлгөөнд «Систем», бусад үед ажилтны нэр
  actorName  String
  stockAfter Int
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdAt])
}

model Banner {
  id        String   @id @default(cuid())
  /// гарчгийн дээрх жижиг шошго («Prius 30 / 50»)
  eyebrow   String   @default("")
  title     String
  subtitle  String   @default("")
  /// товчны текст («Prius сэлбэг үзэх»)
  ctaLabel  String   @default("")
  link      String
  imageUrl  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id         String         @id @default(cuid())
  name       String
  percent    Int
  target     CampaignTarget @default(ALL)
  categoryId String?
  brandId    String?
  startsAt   DateTime       @db.Date
  endsAt     DateTime       @db.Date
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

/// Самбарт засдаг түлхүүр/утгын тохиргоо: «store», «delivery», «qpay»
/// (QPay-ийн нууц утга env-д л байна, энд хэзээ ч биш).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- нэвтрэх оролдлогын хязгаар ----------

/// «ip|key» бүрийн амжилтгүй нэвтрэлт / хайлт; бүх serverless instance хуваалцана.
model LoginThrottle {
  key   String   @id
  count Int      @default(0)
  until DateTime
}

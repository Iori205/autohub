# Repo-ийн язгуурт .env нэрээр хуулна (git-д орохгүй). Бүх апп болон packages/db энэ ганц файлыг уншина.

# ---------- Өгөгдлийн сан (Supabase) ----------
# Апп-уудын холболт: Supabase → Connect → «Transaction pooler» (порт 6543).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"
# Migration-ий шууд холболт (порт 5432); db.<ref>.supabase.co олдохгүй бол «Session pooler»-ийн мөрийг ашигла.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Локал хувилбар: `docker compose up -d`, дараа нь хоёуланд нь:
# DATABASE_URL="postgresql://autohub:autohub@localhost:5432/autohub"
# DIRECT_URL="postgresql://autohub:autohub@localhost:5432/autohub"

# Заавал биш: сервер instance бүрийн холболтын тоо (анхдагч 10, Vercel дээр 3).
# DATABASE_POOL_MAX="3"

# ---------- API (apps/service, http://localhost:4000) ----------
# Сессийн күүкиг гарын үсэглэх 32+ тэмдэгтийн санамсаргүй мөр (`openssl rand -base64 48`).
AUTH_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"
# API-г күүкитэй шууд дуудах хөтчийн origin-ууд; frontend прокси хийдэг тул production-д хоосон үлдээнэ («*» хориотой).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Энэ сервисийн нийтийн URL — QPay төлбөрийн callback-ийг энд дуудна.
PUBLIC_API_URL="http://localhost:4000"
# Хоосон үлдээнэ; web, dashboard нэг эх домэйнд (жишээ нь «.autohub.mn») күүки хуваалцах үед л бөглөнө.
COOKIE_DOMAIN=""

# ---------- Frontend (apps/web, apps/dashboard) ----------
# apps/service-ийн URL, зөвхөн серверт (NEXT_PUBLIC_ биш); /api/* энд прокси хийгдэх тул build үед заавал.
API_URL="http://localhost:4000"

# ---------- QPay (apps/service) ----------
# QPay API-ийн хаяг: sandbox (анхдагч) эсвэл production https://merchant.qpay.mn/v2.
QPAY_BASE_URL="https://merchant-sandbox.qpay.mn/v2"
# QPay-ээс авах merchant нэвтрэх нэр (sandbox: TEST_MERCHANT).
QPAY_USERNAME=""
# QPay-ээс авах merchant нууц үг (sandbox: 123456).
QPAY_PASSWORD=""
# QPay-ээс авах нэхэмжлэхийн код (sandbox: TEST_INVOICE).
QPAY_INVOICE_CODE=""
# true = QPay дуудахгүй, төлбөрийг туршилтын товчоор дуурайна; production-д заавал false.
DEMO_MODE="true"

# ---------- Seed ----------
# Seed хийсэн ажилтны бүртгэлүүдийн нууц үг (admin@autohub.mn, operator1/2@autohub.mn).
SEED_ADMIN_PASSWORD="autohub123"

# =====================================================================================
# Production (Vercel + Supabase) — эдгээрийг энэ файлд биш, Vercel-ийн төсөл бүрт тохируулна.
# Нэг ч хувьсагч NEXT_PUBLIC_ биш, хөтөч рүү юу ч гарахгүй. Заавал хувьсагч дутвал сервис асахгүй.
#
# apps/service (жишээ нь https://autohub-service.vercel.app)
#   DATABASE_URL       Supabase «Transaction pooler», порт 6543
#   AUTH_SECRET        32+ санамсаргүй тэмдэгт (openssl rand -base64 48)
#   PUBLIC_API_URL     https://autohub-service.vercel.app (https; QPay callback-ийн суурь)
#   DEMO_MODE          "false" (жинхэнэ QPay) — заавал тодорхой заана
#   QPAY_BASE_URL      https://merchant.qpay.mn/v2
#   QPAY_USERNAME / QPAY_PASSWORD / QPAY_INVOICE_CODE   (DEMO_MODE=false үед заавал)
#   CORS_ORIGINS, COOKIE_DOMAIN   тохируулахгүй
#   DATABASE_POOL_MAX  заавал биш (Vercel дээр анхдагч 3)
#
# apps/web ба apps/dashboard
#   API_URL            https://autohub-service.vercel.app (хоёуланд ижил)
#
# Зөвхөн өөрийн компьютерт (Vercel-д биш): `npm run db:migrate`-д DIRECT_URL, SEED_ADMIN_PASSWORD.
# =====================================================================================

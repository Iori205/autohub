# Copy to .env at the repo root (gitignored). Every app and packages/db read this one file.

# ---------- Database (Supabase) ----------
# Supabase → Project → Connect → ORMs / Prisma.
# Pooled connection used by the running apps — "Transaction pooler", port 6543.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"
# Direct connection used by migrations (prisma migrate) — port 5432.
# If db.<ref>.supabase.co doesn't resolve on your network (it is IPv6-only),
# use the "Session pooler" string instead (pooler host, port 5432).
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Local alternative: `docker compose up -d` (docker-compose.yml), then use for both:
# DATABASE_URL="postgresql://autohub:autohub@localhost:5432/autohub"
# DIRECT_URL="postgresql://autohub:autohub@localhost:5432/autohub"

# Optional: connections per server instance (default 10; 3 on Vercel).
# DATABASE_POOL_MAX="3"

# ---------- API (apps/service, http://localhost:4000) ----------
# Signs session cookies. Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"
# Browser origins allowed to call the API *directly* with cookies. The frontends proxy
# /api/* (same origin), so this only matters for tools calling the API cross-origin.
# Exact origins only — "*" is rejected. Default when unset: localhost:3000/3001 in dev, none in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# This service's own public URL — QPay calls the payment callback on it.
PUBLIC_API_URL="http://localhost:4000"
# Leave empty. Only if web + dashboard share a parent domain and you want one cookie for both,
# e.g. ".autohub.mn". Never a *.vercel.app value (public suffix — browsers reject it).
COOKIE_DOMAIN=""

# ---------- Frontends (apps/web, apps/dashboard) ----------
# URL of apps/service, server-only (NOT NEXT_PUBLIC_). The browser calls /api/* on the
# frontend's own domain and Next.js rewrites it here; server-side fetches use it directly.
# Needed at build time (rewrites are fixed by `next build`). Default in dev: http://localhost:4000.
API_URL="http://localhost:4000"

# ---------- QPay (apps/service) ----------
# Sandbox by default; production: https://merchant.qpay.mn/v2
QPAY_BASE_URL="https://merchant-sandbox.qpay.mn/v2"
# Merchant credentials from QPay (sandbox test merchant: TEST_MERCHANT / 123456 / TEST_INVOICE).
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
# true = no calls to QPay: invoices get a local QR and /api/v1/payments/demo/{paid,expired,error}
# simulate the outcome. Must be false in production (the demo endpoints then return 404).
DEMO_MODE="true"

# ---------- Seed ----------
# Password given to the seeded staff accounts (admin@autohub.mn, operator1/2@autohub.mn).
SEED_ADMIN_PASSWORD="autohub123"

# =====================================================================================
# Production (Vercel + Supabase) — set these in each Vercel project, not in this file.
# Nothing here is NEXT_PUBLIC_: no variable is exposed to the browser.
# The service refuses to start (instrumentation.ts) if a required one is missing.
#
# apps/service (e.g. https://autohub-service.vercel.app)
#   DATABASE_URL       Supabase "Transaction pooler" string, port 6543
#   AUTH_SECRET        32+ random chars (openssl rand -base64 48)
#   PUBLIC_API_URL     https://autohub-service.vercel.app   (https; QPay callback base)
#   DEMO_MODE          "false" (real QPay) — must be set explicitly
#   QPAY_BASE_URL      https://merchant.qpay.mn/v2           (sandbox: https://merchant-sandbox.qpay.mn/v2)
#   QPAY_USERNAME / QPAY_PASSWORD / QPAY_INVOICE_CODE         (required when DEMO_MODE=false)
#   CORS_ORIGINS       leave unset (frontends proxy /api/*)
#   COOKIE_DOMAIN      leave unset
#   DATABASE_POOL_MAX  optional (default 3 on Vercel)
#
# apps/web and apps/dashboard
#   API_URL            https://autohub-service.vercel.app   (same value in both)
#
# Your machine only (never on Vercel): DIRECT_URL for `npm run db:migrate`, SEED_ADMIN_PASSWORD.
# =====================================================================================
